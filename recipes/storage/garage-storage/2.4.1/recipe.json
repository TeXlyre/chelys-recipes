{
  "id": "garage-storage",
  "type": "storage",
  "name": "Garage",
  "description": "Durable opaque TeXlyre project storage backed by Garage.",
  "notes": "Runs Garage and the TeXlyre Storage Bridge in one container. Garage credentials remain internal to the container and are persisted with Garage data. TeXlyre connects only to the WebSocket storage protocol.",
  "tags": [
    "storage",
    "garage",
    "s3",
    "local-first"
  ],
  "author": "TeXlyre",
  "version": "2.4.1",
  "lastUpdated": "2026-10-06T00:00:00Z",
  "variables": [
    {
      "key": "wsPort",
      "label": "WebSocket port",
      "kind": "number",
      "default": "7060",
      "help": "Port the TeXlyre Storage Bridge listens on."
    }
  ],
  "env": {},
  "modes": [
    {
      "kind": "docker",
      "image": "ghcr.io/texlyre/chelys-recipe-garage:2.4.1",
      "dockerfileUrl": "Dockerfile",
      "buildSteps": [],
      "runArgs": [
        "-p",
        "${wsPort}:${wsPort}",
        "-e",
        "WS_PORT=${wsPort}"
      ],
      "volumes": [
        {
          "id": "data",
          "target": "/var/lib/garage"
        }
      ]
    },
    {
      "kind": "connect"
    }
  ],
  "typeConfig": {
    "configId": "garage-storage",
    "transportType": "websocket",
    "transportUrl": "ws://localhost:${wsPort}"
  },
  "extraFiles": [
    "bridge.cjs",
    "storage-backend.cjs",
    "storage-core.cjs",
    "s3-store.cjs",
    "entrypoint.sh"
  ]
}
